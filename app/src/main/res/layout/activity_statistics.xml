<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportify_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/sportify_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Your Progress"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/sportify_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebugRandomData"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[DEBUG]"
                android:textSize="10sp"
                android:textColor="@color/sportify_text_secondary"
                app:strokeColor="@color/sportify_text_hint" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Weight Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sportify_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight Trend"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/sportify_text_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartWeight"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeight7d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="This Week"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeight30d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="1 Month"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeight90d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="3 Months"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Steps Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sportify_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity (Steps)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/sportify_text_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartSteps"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSteps7d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="This Week"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSteps14d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="2 Weeks"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSteps30d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="1 Month"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Calories Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sportify_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calories Intake"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/sportify_text_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartCalories"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCal7d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="This Week"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCal14d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="2 Weeks"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCal30d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="1 Month"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sleep Quality Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sportify_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep Quality"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/sportify_text_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartSleepQuality"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSleepQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSleep7d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="This Week"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSleep14d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="2 Weeks"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSleep30d"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="1 Month"
                            android:textSize="11sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddWeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="Log Weight"
        android:textColor="@color/sportify_text_on_green"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/sportify_text_on_green"
        app:backgroundTint="@color/sportify_green" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
